# ==========================================================================
# Copy to `.env` and fill in. Only the two keys under REQUIRED are needed.
# ==========================================================================

# --- REQUIRED ---
GROQ_API_KEY=your_groq_api_key_here      # LLM + STT + TTS (get one at console.groq.com)
HF_TOKEN=your_hf_token_here              # vision model via HuggingFace router

# --- LLM ---
# LLM_PROVIDER=groq                      # groq | anthropic (Claude, strongest)
# LLM_MODEL=llama-3.1-8b-instant         # for Groq: llama-3.1-8b-instant | llama-3.3-70b-versatile | openai/gpt-oss-120b
# LLM_FAST_MODEL=llama-3.1-8b-instant    # routing/consolidation (Groq only)
# LLM_ENABLE_TOOLS=true
# LLM_TEMPERATURE=0.3                    # lower = less hallucination
# SCENE_FRESHNESS_S=45                   # don't call a perception "current" if older than this

# --- Claude (only used when LLM_PROVIDER=anthropic) ---
# NOTE: a Claude Pro subscription does NOT grant API access — get a separate
#       pay-as-you-go key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # or claude-sonnet-5 (cheaper) / claude-haiku-4-5 (fastest)

# --- Speech-to-text ---
# STT_BACKEND=groq                       # groq | faster_whisper | whisper
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en                        # leave unset for auto-detect

# --- Text-to-speech ---
# TTS_ENABLED=true
# TTS_BACKEND=groq            # groq (Orpheus, needs terms) | spd | pyttsx3 | none
#                             # groq auto-falls back to local voice if unavailable.
#                             # For instant offline voice with no cloud call: TTS_BACKEND=spd
# TTS_GROQ_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=tara              # Orpheus voices: tara, leah, jess, leo, dan, mia, zac, zoe

# --- Voice activity / wake word ---
# VAD_BACKEND=silero                     # silero | webrtc | energy
# WAKEWORD_ENABLED=false                 # true => only responds after "Hey Jarvis"

# --- Vision ---
# VISION_ENABLED=true
# VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct   # also available: Qwen/Qwen2.5-VL-72B-Instruct, google/gemma-3-4b-it
# VISION_MAX_FPS=0.5                      # cap VLM calls/sec (cost/latency guard)
# VISION_SCENE_CHANGE_THRESHOLD=0.35     # only analyze when the scene changes

# --- Memory ---
# EMBEDDING_BACKEND=sentence_transformers  # sentence_transformers | fastembed | hash
# MEMORY_TOP_K=5
# MEMORY_CONSOLIDATE_EVERY=20

# LOG_LEVEL=INFO
