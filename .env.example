# ==========================================================================
# Copy to `.env` and fill in. Only the two keys under REQUIRED are needed.
# ==========================================================================

# --- REQUIRED ---
GROQ_API_KEY=your_groq_api_key_here      # LLM + STT + TTS (get one at console.groq.com)
HF_TOKEN=your_hf_token_here              # vision model via HuggingFace router

# --- LLM ---
# LLM_PROVIDER=groq                      # groq | gemini | anthropic (Claude)
# LLM_MODEL=openai/gpt-oss-120b          # Groq chat models: openai/gpt-oss-120b | openai/gpt-oss-20b | qwen/qwen3.6-27b
#                                        # NOTE: the llama-3.x models were retired from Groq — they now 404.
#                                        # Check what your key can use:  curl -H "Authorization: Bearer $GROQ_API_KEY" \
#                                        #   https://api.groq.com/openai/v1/models
# LLM_FAST_MODEL=openai/gpt-oss-20b      # consolidation (Groq only)
# LLM_REASONING_EFFORT=low               # low | medium | high | none — gpt-oss/qwen3 think before the
#                                        # first token, so this IS your time-to-first-token (~120ms vs ~490ms)
# LLM_ENABLE_TOOLS=true
# LLM_TEMPERATURE=0.3                    # lower = less hallucination
# SCENE_FRESHNESS_S=45                   # don't call a perception "current" if older than this

# --- Claude (only used when LLM_PROVIDER=anthropic) ---
# NOTE: a Claude Pro subscription does NOT grant API access — get a separate
#       pay-as-you-go key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # or claude-sonnet-5 (cheaper) / claude-haiku-4-5 (fastest)

# --- Speech-to-text ---
# STT_BACKEND=groq                       # groq | faster_whisper | whisper
# STT_GROQ_MODEL=whisper-large-v3-turbo
# STT_LANGUAGE=en                        # leave unset for auto-detect

# --- Text-to-speech ---
# TTS_ENABLED=true
# TTS_BACKEND=groq            # groq (Orpheus, needs terms) | spd | pyttsx3 | none
#                             # groq auto-falls back to local voice if unavailable.
#                             # For instant offline voice with no cloud call: TTS_BACKEND=spd
# TTS_GROQ_MODEL=canopylabs/orpheus-v1-english
# TTS_VOICE=tara              # Orpheus voices: tara, leah, jess, leo, dan, mia, zac, zoe

# --- Voice activity / wake word ---
# VAD_BACKEND=silero                     # silero | webrtc | energy
# WAKEWORD_ENABLED=false                 # true => only responds after "Hey Jarvis"

# --- Vision ---
# VISION_ENABLED=true
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct  # also: Qwen/Qwen2.5-VL-72B-Instruct, google/gemma-3-27b-it
#                                        # Must be served by a provider enabled on your HF account. List them:
#                                        #   curl -H "Authorization: Bearer $HF_TOKEN" https://router.huggingface.co/v1/models
# VISION_MAX_FPS=0.5                      # cap VLM calls/sec (cost/latency guard)
# VISION_SCENE_CHANGE_THRESHOLD=0.35     # only analyze when the scene changes

# --- Memory ---
# EMBEDDING_BACKEND=sentence_transformers  # sentence_transformers | fastembed | hash
# MEMORY_TOP_K=3
# MEMORY_CONSOLIDATE_EVERY=20
# --- memory precision (anti-hallucination) ---
# MEMORY_RELEVANCE_THRESHOLD=0.45        # cosine a stored fact must beat to reach the LLM. Raise if the
#                                        # assistant drags in irrelevant facts; lower if it forgets things.
# MEMORY_ALWAYS_RETRIEVE=false           # true = search memory on every turn (legacy; noisier)
# MEMORY_DEDUPE_THRESHOLD=0.92           # a new fact this close to an existing one is not stored
# MEMORY_STALE_AFTER_S=86400             # facts older than this are labelled "may be outdated"
# MEMORY_EXCLUDE_DIALOGUE=true           # keep the conversation out of the context block (it is already
#                                        # sent as native chat turns; duplicating it makes models blend turns)

# LOG_LEVEL=INFO
